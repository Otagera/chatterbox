extends layout

block content
  .cb-app
    //- top bar
    .cb-topbar
      .cb-brand(style="font-size:16px")
        span.cb-logo ◆
        span Chatterbox
      a.cb-appsel(href="/")= appName
        span.car ▾
      .cb-spacer
      .cb-seg
        each r in ranges
          a(href=`/?range=${r}` class=(range === r ? "on" : ""))= r
      button.cb-live#cb-live(type="button" data-range=range)
        span.pulse
        span Live
      a.cb-btn.cb-btn--ghost(href="/analytics") Analytics
      a.cb-btn.cb-btn--ghost(href="/view/authorize" hx-get="/view/authorize" hx-target="this" hx-swap="outerHTML") New key
      button.cb-btn.cb-btn--danger(hx-post="/view/logout") Logout

    //- overview
    .cb-overview
      .cb-tile
        .k Events
        .v= overview.total.toLocaleString()
        .sub last #{range}
      .cb-tile.err
        .k Error rate
        .v #{overview.errorRate.toFixed(1)}%
        != sparkline
      .cb-tile
        .k Warnings
        .v= overview.warnings.toLocaleString()
        .sub last #{range}
      .cb-tile.levels
        .k Levels
        .cb-levelbar
          each seg in levelBar
            i(style=`width:${seg.pct}%; background:var(--cb-${seg.level})`)
        .cb-lgnd
          each seg in levelBar
            span
              b(style=`background:var(--cb-${seg.level})`)
              | #{seg.level.charAt(0).toUpperCase() + seg.level.slice(1)} #{seg.count.toLocaleString()}
          if levelBar.length === 0
            span(style="color:var(--cb-faint)") No events in this window

    //- toolbar (facets + search)
    .cb-toolbar
      .cb-chips
        button.cb-chip.on(type="button" data-level="all" hx-get=`/view/stream?range=${range}&level=all` hx-target="#cb-rows" hx-swap="innerHTML" onclick="cbSelChip(this)")
          | All
          span.ct= overview.total.toLocaleString()
        each lv in ["info", "warn", "error", "fatal", "debug"]
          button.cb-chip(type="button" data-level=lv hx-get=`/view/stream?range=${range}&level=${lv}` hx-target="#cb-rows" hx-swap="innerHTML" onclick="cbSelChip(this)")
            span.sw(style=`background:var(--cb-${lv})`)
            | #{lv.charAt(0).toUpperCase() + lv.slice(1)}
            span.ct= (overview.counts[lv] || 0).toLocaleString()
      .cb-searchbox
        span.mag ⌕
        input(type="text" name="q" placeholder="Filter by key…" hx-get=`/view/stream?range=${range}` hx-target="#cb-rows" hx-swap="innerHTML" hx-trigger="keyup changed delay:300ms, search" hx-include="this")

    //- board: stream + drawer
    .cb-board
      .cb-stream
        .cb-streamhead
          span #{overview.total.toLocaleString()} events
          span Newest first
        #cb-rows
          != streamHtml
      aside.cb-drawer.cb-card#cb-drawer
        .cb-drawer-empty Select a log to see its full detail — decrypted data, request, trace, and errors.

block scripts
  script.
    var cbLevel = 'all';

    function cbSelChip(el) {
      document.querySelectorAll('.cb-chip').forEach(function (c) { c.classList.remove('on'); });
      el.classList.add('on');
      cbLevel = el.getAttribute('data-level') || 'all';
    }

    // Highlight the selected row when its detail loads into the drawer.
    document.addEventListener('click', function (e) {
      var row = e.target.closest('.cb-row');
      if (!row) return;
      document.querySelectorAll('.cb-row.is-sel').forEach(function (r) { r.classList.remove('is-sel'); });
      row.classList.add('is-sel');
    });

    // Live tail: while on, re-fetch the newest page for the active filter every few seconds.
    var live = document.getElementById('cb-live');
    var cbRange = live ? (live.getAttribute('data-range') || '24h') : '24h';
    var liveTimer = null;
    function cbStreamUrl() {
      var u = '/view/stream?range=' + encodeURIComponent(cbRange);
      if (cbLevel && cbLevel !== 'all') u += '&level=' + encodeURIComponent(cbLevel);
      return u;
    }
    if (live) {
      live.addEventListener('click', function () {
        live.classList.toggle('on');
        if (live.classList.contains('on')) {
          liveTimer = setInterval(function () {
            if (window.htmx) window.htmx.ajax('GET', cbStreamUrl(), '#cb-rows');
          }, 5000);
        } else if (liveTimer) {
          clearInterval(liveTimer);
          liveTimer = null;
        }
      });
    }
