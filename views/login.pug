extends layout

block content
  main.cb-authwrap
    .cb-authcard.cb-card
      .cb-brand(style="font-size:20px; justify-content:center; margin-bottom:6px")
        span.cb-logo ◆
        span Chatterbox
      p.cb-sub(style="text-align:center; margin:0 0 24px; font-size:14px") Sign in to view your application logs.
      form(hx-post="/view/login" hx-swap="outerHTML")
        label.cb-label(for="email") Email
        input.cb-input(type="email" placeholder="you@example.com" name="email" id="email" required autocomplete="email")
        button.cb-btn.cb-btn--primary.cb-btn--block(type="submit" style="margin-top:16px") Continue
