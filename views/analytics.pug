extends layout

block head
  script(src="https://cdn.jsdelivr.net/npm/chart.js")

block content
  .cb-app
    //- top bar
    .cb-topbar
      .cb-brand(style="font-size:16px")
        span.cb-logo ◆
        span Chatterbox
      a.cb-appsel(href="/")= appName
        span.car ▾
      .cb-spacer
      a.cb-btn.cb-btn--ghost(href="/") Logs
      a.cb-btn.cb-btn--ghost(href="/view/authorize" hx-get="/view/authorize" hx-target="this" hx-swap="outerHTML") New key
      button.cb-btn.cb-btn--danger(hx-post="/view/logout") Logout

    .cb-page-title
      h1.cb-h1 Analytics
      span.cb-sub last 7 days · #{appName}

    .cb-charts
      .cb-card.cb-chartcard
        h3.cb-chart-title Log volume over time
        .cb-chart-wrap
          canvas#logVolumeChart
      .cb-card.cb-chartcard
        h3.cb-chart-title Level distribution
        .cb-chart-wrap.cb-chart-wrap--pie
          canvas#logLevelDistributionChart
      .cb-card.cb-chartcard
        h3.cb-chart-title Top log keys
        .cb-chart-wrap
          canvas#topKeysChart
      .cb-card.cb-chartcard
        h3.cb-chart-title Error rate over time
        .cb-chart-wrap
          canvas#errorRateChart

block scripts
  script.
    const chartData = !{JSON.stringify(chartData || {})};
  script(src="/js/analytics.js")
