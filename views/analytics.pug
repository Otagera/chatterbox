extends layout

block head
  script(src="https://cdn.jsdelivr.net/npm/chart.js")

block content
  .cb-app
    //- top bar
    .cb-topbar
      .cb-brand(style="font-size:16px")
        span.cb-logo ◆
        span Chatterbox
      a.cb-appsel(href="/")= appName
        span.car ▾
      .cb-spacer
      .cb-seg
        each r in ranges
          a(href=`/analytics?range=${r}` class=(range === r ? "on" : ""))= r
      a.cb-btn.cb-btn--ghost(href="/") Logs
      a.cb-btn.cb-btn--ghost(href="/view/authorize" hx-get="/view/authorize" hx-target="this" hx-swap="outerHTML") New key
      button.cb-btn.cb-btn--danger(hx-post="/view/logout") Logout

    .cb-page-title
      h1.cb-h1 Analytics
      span.cb-sub last #{range} · #{appName}

    //- RED metrics per endpoint (rate, errors, duration)
    .cb-card.cb-chartcard(style="margin-bottom:16px")
      h3.cb-chart-title Endpoints
      if endpoints && endpoints.length
        .tablewrap
          table.cb-endpoints
            thead
              tr
                th Endpoint
                th.num Requests
                th.num Errors
                th.num Error rate
                th.num p50
                th.num p95
            tbody
              each e in endpoints
                tr
                  td
                    span.cb-ep-method= e.method
                    span.cb-ep-url= e.url
                  td.num= e.count.toLocaleString()
                  td.num= e.errors.toLocaleString()
                  td.num(class=(e.errorRate >= 5 ? "is-bad" : ""))= e.errorRate.toFixed(1) + "%"
                  td.num= e.p50 == null ? "—" : e.p50 + "ms"
                  td.num= e.p95 == null ? "—" : e.p95 + "ms"
      else
        p.cb-note No request logs in this window. Send logs with a
          |  #[code request] object (method + url) and a numeric #[code timeTaken] to populate this.

    //- alert rules
    .cb-card.cb-chartcard(style="margin-bottom:16px")
      h3.cb-chart-title Alerts
      p.cb-note(style="margin:-6px 0 12px") Evaluated in the background; notifications are emailed when a threshold is exceeded.
      #cb-alerts!= alertsHtml

    .cb-charts
      .cb-card.cb-chartcard
        h3.cb-chart-title Log volume over time
        .cb-chart-wrap
          canvas#logVolumeChart
      .cb-card.cb-chartcard
        h3.cb-chart-title Level distribution
        .cb-chart-wrap.cb-chart-wrap--pie
          canvas#logLevelDistributionChart
      .cb-card.cb-chartcard
        h3.cb-chart-title Top log keys
        .cb-chart-wrap
          canvas#topKeysChart
      .cb-card.cb-chartcard
        h3.cb-chart-title Error rate over time
        .cb-chart-wrap
          canvas#errorRateChart

block scripts
  script.
    const chartData = !{JSON.stringify(chartData || {})};
  script(src="/js/analytics.js")
