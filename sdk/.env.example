# URL of your running Chatterbox server (no trailing slash)
CHATTERBOX_API_URL=http://localhost:3005

# App credentials — obtained from POST /api/users/apps
CHATTERBOX_APP_NAME=my-service
CHATTERBOX_API_SECRET=chbxsk_xxxxxxxxxxxxxxxxxxxxxxxx_ZEE

# Optional: local retry-queue tuning
LOG_FILE=logQueue.json
RETRY_DELAY_MS=10000
MAX_BULK_LOG=10
