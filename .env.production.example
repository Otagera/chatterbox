# Environment variables for the deployed app.
#
# These are set in the COOLIFY UI (Environment Variables for the resource) —
# docker-compose.yml reads them via ${VAR} interpolation. This file is a
# checklist, not something you copy to the server.
#
# It doubles as the env for local compose testing:
#   set -a; . ./.env.production; set +a; docker compose up -d

# ---- required: the app refuses to start in production without these ----
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Master key used to derive per-app log-encryption keys.
# WARNING: changing this makes previously stored log data undecryptable.
ENCRYPTION_KEY=

# ---- database ----
# DB_URL and REDIS_URL are hardcoded in docker-compose.yml to the internal
# service names (mongo / redis). Only override them for external data stores.
DB_NAME=chatterbox

# ---- email (Resend) ----
PROCESS_EMAILS=true
RESEND_API_KEY=
RESEND_SENDER="Chatterbox <noreply@example.com>"

# ---- queue dashboard (/worker/admin) ----
# Job payloads contain OTP codes. Without BOTH of these set, the dashboard is
# disabled entirely in production.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ---- optional: strengthen token/OTP hashes (changing it invalidates existing hashes) ----
HASH_PEPPER=

# ---- set by CI, not by hand ----
# The deploy workflow pushes ghcr.io/<owner>/<repo>:<sha>; Coolify pulls it.
# APP_IMAGE=ghcr.io/otagera/chatterbox:latest
